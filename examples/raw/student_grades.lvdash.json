{
  "datasets": [
    {
      "name": "4e67be8b",
      "displayName": "dept_avg_grades",
      "queryLines": [
        "SELECT \n",
        "  s.department, \n",
        "  ROUND(AVG(g.score), 1) AS avg_score, \n",
        "  COUNT(DISTINCT s.student_id) AS student_count \n",
        "FROM grades g \n",
        "JOIN students s USING (student_id) \n",
        "GROUP BY s.department \n",
        "ORDER BY avg_score DESC; "
      ],
      "catalog": "dev",
      "schema": "bronze"
    },
    {
      "name": "65a632a6",
      "displayName": "course_performance",
      "queryLines": [
        "SELECT \n",
        "\n",
        "  c.course_name, \n",
        "\n",
        "  c.department, \n",
        "\n",
        "  c.credits, \n",
        "\n",
        "  ROUND(AVG(g.score), 1) AS avg_score, \n",
        "\n",
        "  MIN(g.score) AS min_score, \n",
        "\n",
        "  MAX(g.score) AS max_score, \n",
        "\n",
        "  COUNT(*) AS total_enrollments \n",
        "\n",
        "FROM grades g \n",
        "\n",
        "JOIN courses c USING (course_id) \n",
        "\n",
        "GROUP BY c.course_name, c.department, c.credits \n",
        "\n",
        "ORDER BY avg_score DESC;"
      ],
      "catalog": "dev",
      "schema": "bronze"
    },
    {
      "name": "bc724b90",
      "displayName": "student_grades",
      "queryLines": [
        "SELECT \n",
        "\n",
        "  s.student_name, \n",
        "\n",
        "  s.department, \n",
        "\n",
        "  s.enrollment_year, \n",
        "\n",
        "  c.course_name, \n",
        "\n",
        "  c.credits, \n",
        "\n",
        "  g.score, \n",
        "\n",
        "  CASE \n",
        "\n",
        "    WHEN g.score >= 90 THEN 'A' \n",
        "\n",
        "    WHEN g.score >= 80 THEN 'B' \n",
        "\n",
        "    WHEN g.score >= 70 THEN 'C' \n",
        "\n",
        "    WHEN g.score >= 60 THEN 'D' \n",
        "\n",
        "    ELSE 'F' \n",
        "\n",
        "  END AS grade_letter \n",
        "\n",
        "FROM grades g \n",
        "\n",
        "JOIN students s USING (student_id) \n",
        "\n",
        "JOIN courses c USING (course_id); "
      ],
      "catalog": "dev",
      "schema": "bronze"
    },
    {
      "name": "6ecbd922",
      "displayName": "enrollment_semester",
      "queryLines": [
        "SELECT \n",
        "\n",
        "  semester, \n",
        "\n",
        "  s.department, \n",
        "\n",
        "  COUNT(*) AS enrollment_count \n",
        "\n",
        "FROM enrollments e \n",
        "\n",
        "JOIN students s USING (student_id) \n",
        "\n",
        "GROUP BY semester, s.department \n",
        "\n",
        "ORDER BY semester; "
      ],
      "catalog": "dev",
      "schema": "bronze"
    },
    {
      "name": "da022da1",
      "displayName": "dept_grade_heatmap",
      "queryLines": [
        "SELECT \n",
        "\n",
        "  s.department, \n",
        "\n",
        "  CASE \n",
        "\n",
        "    WHEN g.score >= 90 THEN 'A' \n",
        "\n",
        "    WHEN g.score >= 80 THEN 'B' \n",
        "\n",
        "    WHEN g.score >= 70 THEN 'C' \n",
        "\n",
        "    WHEN g.score >= 60 THEN 'D' \n",
        "\n",
        "    ELSE 'F' \n",
        "\n",
        "  END AS grade_letter, \n",
        "\n",
        "  COUNT(*) AS student_count \n",
        "\n",
        "FROM grades g \n",
        "\n",
        "JOIN students s USING (student_id) \n",
        "\n",
        "GROUP BY s.department, grade_letter \n",
        "\n",
        "ORDER BY s.department, grade_letter; "
      ],
      "catalog": "dev",
      "schema": "bronze"
    },
    {
      "name": "46a9e615",
      "displayName": "overall_metrics",
      "queryLines": [
        "SELECT \n",
        "\n",
        "  COUNT(DISTINCT student_id) AS total_students, \n",
        "\n",
        "  COUNT(DISTINCT course_id)  AS total_courses, \n",
        "\n",
        "  ROUND(AVG(score), 1)       AS overall_avg_score \n",
        "\n",
        "FROM grades; "
      ],
      "catalog": "dev",
      "schema": "bronze"
    },
    {
      "name": "enrollment_forecast",
      "displayName": "enrollment_forecast",
      "queryLines": [
        "WITH historical AS (\n",
        "  SELECT\n",
        "    semester,\n",
        "    SUM(enrollment_count) AS total_enrollment\n",
        "  FROM\n",
        "    (\n",
        "      SELECT\n",
        "        semester,\n",
        "        COUNT(*) AS enrollment_count\n",
        "      FROM\n",
        "        enrollments e JOIN students s USING (student_id)\n",
        "      GROUP BY\n",
        "        semester\n",
        "    )\n",
        "  GROUP BY\n",
        "    semester\n",
        "),\n",
        "dated AS (\n",
        "  SELECT\n",
        "    semester,\n",
        "    DATE_ADD(\n",
        "      DATE '2020-01-01',\n",
        "      CAST((ROW_NUMBER() OVER (ORDER BY semester) - 1) * 180 AS INT)\n",
        "    ) AS ds,\n",
        "    CAST(total_enrollment AS DOUBLE) AS total_enrollment\n",
        "  FROM\n",
        "    historical\n",
        "),\n",
        "forecasted AS (\n",
        "  SELECT\n",
        "    *\n",
        "  FROM\n",
        "    ai_forecast(\n",
        "      TABLE(dated),\n",
        "      horizon =>\n",
        "        (\n",
        "          SELECT\n",
        "            DATE_ADD(MAX(ds), 720)\n",
        "          FROM\n",
        "            dated\n",
        "        ),\n",
        "      time_col => 'ds',\n",
        "      value_col => 'total_enrollment',\n",
        "      prediction_interval_width => 0.95,\n",
        "      version => '1'\n",
        "    )\n",
        "),\n",
        "combined AS (\n",
        "  SELECT\n",
        "    d.semester,\n",
        "    d.ds,\n",
        "    d.total_enrollment AS original,\n",
        "    CAST(NULL AS DOUBLE) AS prediction,\n",
        "    CAST(NULL AS DOUBLE) AS prediction_upper,\n",
        "    CAST(NULL AS DOUBLE) AS prediction_lower\n",
        "  FROM\n",
        "    dated d\n",
        "  UNION ALL\n",
        "  SELECT\n",
        "    d.semester,\n",
        "    d.ds,\n",
        "    CAST(NULL AS DOUBLE),\n",
        "    d.total_enrollment,\n",
        "    d.total_enrollment,\n",
        "    d.total_enrollment\n",
        "  FROM\n",
        "    dated d\n",
        "  WHERE\n",
        "    d.ds\n",
        "      = (\n",
        "        SELECT\n",
        "          MAX(ds)\n",
        "        FROM\n",
        "          dated\n",
        "      )\n",
        "  UNION ALL\n",
        "  SELECT\n",
        "    CONCAT('Forecast-', CAST(ROW_NUMBER() OVER (ORDER BY f.ds) AS STRING)) AS semester,\n",
        "    f.ds,\n",
        "    CAST(NULL AS DOUBLE),\n",
        "    f.total_enrollment_forecast,\n",
        "    f.total_enrollment_upper,\n",
        "    f.total_enrollment_lower\n",
        "  FROM\n",
        "    forecasted f\n",
        "  WHERE\n",
        "    f.ds\n",
        "      > (\n",
        "        SELECT\n",
        "          MAX(ds)\n",
        "        FROM\n",
        "          dated\n",
        "      )\n",
        ")\n",
        "SELECT\n",
        "  semester,\n",
        "  ds,\n",
        "  original,\n",
        "  prediction,\n",
        "  prediction_upper,\n",
        "  prediction_lower\n",
        "FROM\n",
        "  combined\n",
        "ORDER BY\n",
        "  ds"
      ],
      "catalog": "dev",
      "schema": "bronze"
    }
  ],
