{
  "datasets": [
    {
      "name": "c83731e4",
      "displayName": "Job Runs",
      "queryLines": [
        "WITH most_recent_job_configuration AS (\r\n",
        "    SELECT\r\n",
        "        *,\r\n",
        "        ROW_NUMBER() OVER (PARTITION BY workspace_id, job_id ORDER BY change_time DESC) AS rn\r\n",
        "    FROM\r\n",
        "        system.lakeflow.jobs\r\n",
        ")\r\n",
        "\r\n",
        "SELECT\r\n",
        "  FROM_UTC_TIMESTAMP(jrt.period_start_time, 'Europe/Amsterdam') AS start_time,\r\n",
        "  FROM_UTC_TIMESTAMP(jrt.period_end_time, 'Europe/Amsterdam') AS end_time,\r\n",
        "  date_format(FROM_UTC_TIMESTAMP(jrt.period_start_time, 'Europe/Amsterdam'), 'yyyy-MM-dd HH:mm:ss') AS start_time_formatted, -- to be used in table column start_time\r\n",
        "  date_format(FROM_UTC_TIMESTAMP(jrt.period_end_time, 'Europe/Amsterdam'), 'yyyy-MM-dd HH:mm:ss') AS end_time_formatted, -- to be used in table column start_time\r\n",
        "  COALESCE(job.name, jrt.run_name) AS name,\r\n",
        "  CASE jrt.run_type\r\n",
        "    WHEN 'JOB_RUN' THEN 'Manually'\r\n",
        "    WHEN 'SUBMIT_RUN' THEN 'By runs submit API'\r\n",
        "    ELSE jrt.run_type\r\n",
        "  END AS launched_by,\r\n",
        "  UNIX_TIMESTAMP(jrt.period_end_time) - UNIX_TIMESTAMP(jrt.period_start_time) AS duration_seconds,\r\n",
        "  CASE\r\n",
        "    WHEN duration_seconds >= 3600 THEN\r\n",
        "      CONCAT(\r\n",
        "        FLOOR(duration_seconds / 3600), 'h ',\r\n",
        "        FLOOR((duration_seconds % 3600) / 60), 'm ',\r\n",
        "        duration_seconds % 60, 's'\r\n",
        "      )\r\n",
        "    WHEN duration_seconds >= 60 THEN\r\n",
        "      CONCAT(\r\n",
        "        FLOOR(duration_seconds / 60), 'm ',\r\n",
        "        duration_seconds % 60, 's'\r\n",
        "      )\r\n",
        "    ELSE\r\n",
        "      CONCAT(duration_seconds, 's')\r\n",
        "  END AS duration,\r\n",
        "  CASE jrt.result_state\r\n",
        "    WHEN 'SUCCEEDED' THEN 'Succeeded'\r\n",
        "    WHEN 'ERROR' THEN 'Failed'\r\n",
        "    -- Jobs & Pipelines UI shows American English spelling, while system table contains British English spelling.\r\n",
        "    WHEN 'CANCELLED' THEN 'Canceled'\r\n",
        "    ELSE jrt.result_state\r\n",
        "  END AS status,\r\n",
        "  CASE jrt.termination_code\r\n",
        "    WHEN 'RUN_EXECUTION_ERROR' THEN 'RunExecutionError'\r\n",
        "    -- Jobs & Pipelines UI shows American English spelling, while system table contains British English spelling.\r\n",
        "    WHEN 'USER_CANCELLED' THEN 'UserCanceled'\r\n",
        "    WHEN 'SUCCESS' THEN ''\r\n",
        "  END AS error_code,\r\n",
        "  jrt.workspace_id, -- to be used in url in table column start_time\r\n",
        "  jrt.run_id, -- to be used in url in table column start_time\r\n",
        "  job.job_id -- to be used in url in table column start_time\r\n",
        "FROM\r\n",
        "  system.lakeflow.job_run_timeline AS jrt\r\n",
        "LEFT JOIN most_recent_job_configuration AS job\r\n",
        "      ON jrt.workspace_id = job.workspace_id\r\n",
        "      AND jrt.job_id = job.job_id\r\n",
        "      AND job.rn = 1\r\n",
        "WHERE\r\n",
        "  jrt.run_type IN ('JOB_RUN', 'SUBMIT_RUN')\r\n",
        "  AND jrt.result_state IS NOT NULL\r\n",
        "  AND jrt.workspace_id = '1234567890123456'\r\n",
        "  AND NOT (\r\n",
        "    -- to match Jobs & Pipelines UI:\r\n",
        "    -- Exclude jobs that have been deleted,\r\n",
        "    --  while an active configuration exists with same workspace_id and name, and different job_id.\r\n",
        "    job.delete_time IS NOT NULL\r\n",
        "    AND EXISTS (\r\n",
        "      SELECT 1\r\n",
        "      FROM system.lakeflow.jobs AS active_job\r\n",
        "      WHERE\r\n",
        "        active_job.workspace_id = job.workspace_id\r\n",
        "        AND active_job.name = job.name\r\n",
        "        AND active_job.delete_time IS NULL\r\n",
        "        AND active_job.job_id <> job.job_id\r\n",
        "    )\r\n",
        "  )\r\n",
        "ORDER BY\r\n",
        "  period_start_time DESC;"
      ]
    }
  ],
