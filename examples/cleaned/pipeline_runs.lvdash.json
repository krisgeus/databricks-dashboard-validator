{
  "datasets": [
    {
      "name": "pipeline_runs",
      "displayName": "Pipeline Runs Monitoring",
      "queryLines": [
        "WITH pipelines_at_least_one_time_completed AS (\n",
        "    SELECT DISTINCT p2.name\n",
        "    FROM system.lakeflow.pipeline_update_timeline AS putl_completed\n",
        "    INNER JOIN system.lakeflow.pipelines AS p2\n",
        "    ON putl_completed.pipeline_id = p2.pipeline_id\n",
        "    WHERE putl_completed.result_state = 'COMPLETED'\n",
        "      AND putl_completed.update_type IN ('REFRESH', 'VALIDATE', 'FULL_REFRESH')\n",
        ")\n",
        "\n",
        "SELECT\n",
        "  FROM_UTC_TIMESTAMP(MIN(putl.period_start_time), 'Europe/Amsterdam') AS start_time, -- to be used in filter widget\n",
        "  FROM_UTC_TIMESTAMP(MAX(putl.period_end_time), 'Europe/Amsterdam') AS end_time, -- to be used in filter widget\n",
        "  DATE_FORMAT(FROM_UTC_TIMESTAMP(MIN(putl.period_start_time), 'Europe/Amsterdam'), 'yyyy-MM-dd HH:mm:ss') AS start_time_formatted, -- to be used in table column start_time\n",
        "  DATE_FORMAT(FROM_UTC_TIMESTAMP(MAX(putl.period_end_time), 'Europe/Amsterdam'), 'yyyy-MM-dd HH:mm:ss') AS end_time_formatted, -- to be used in table column start_time\n",
        "  ANY_VALUE(pipeline.name) AS pipeline_name,\n",
        "  ANY_VALUE(pipeline.pipeline_type) AS pipeline_type,\n",
        "  ANY_VALUE(putl.update_type) AS update_type,\n",
        "  ANY_VALUE(putl.trigger_type) AS trigger_type,\n",
        "  CASE ANY_VALUE(putl.trigger_type)\n",
        "    WHEN 'USER_ACTION' THEN 'Manually'\n",
        "    WHEN 'API' THEN 'By pipelines API'\n",
        "    WHEN 'API_CALL' THEN 'By pipelines API'\n",
        "    WHEN 'JOB_TASK' THEN COALESCE(ANY_VALUE(jtrtl.task_key), 'By job task')\n",
        "    WHEN 'RETRY_ON_FAILURE' THEN COALESCE(ANY_VALUE(jtrtl.task_key), 'Retry on failure')\n",
        "    WHEN 'SCHEDULED' THEN 'Scheduled'\n",
        "    ELSE ANY_VALUE(putl.trigger_type)\n",
        "  END AS launched_by,\n",
        "  CASE MAX(putl.result_state)\n",
        "    WHEN 'COMPLETED' THEN 'Succeeded'\n",
        "    WHEN 'FAILED' THEN 'Failed'\n",
        "    WHEN 'CANCELED' THEN 'Canceled'\n",
        "    ELSE MAX(putl.result_state)\n",
        "  END AS result_state,\n",
        "  MIN(putl.run_as_user_name) AS run_as,\n",
        "  SUM(\n",
        "    UNIX_TIMESTAMP(putl.period_end_time) - UNIX_TIMESTAMP(putl.period_start_time)\n",
        "  ) AS duration_seconds,\n",
        "  CASE\n",
        "    WHEN duration_seconds >= 3600 THEN\n",
        "      CONCAT(\n",
        "        FLOOR(duration_seconds / 3600), 'h ',\n",
        "        FLOOR((duration_seconds % 3600) / 60), 'm ',\n",
        "        duration_seconds % 60, 's'\n",
        "      )\n",
        "    WHEN duration_seconds >= 60 THEN\n",
        "      CONCAT(\n",
        "        FLOOR(duration_seconds / 60), 'm ',\n",
        "        duration_seconds % 60, 's'\n",
        "      )\n",
        "    ELSE\n",
        "      CONCAT(duration_seconds, 's')\n",
        "  END AS duration,\n",
        "  ANY_VALUE(putl.trigger_details.job_task.job_id) AS triggered_by_job_id,\n",
        "  ANY_VALUE(putl.trigger_details.job_task.job_task_run_id) AS triggered_by_job_run_id,\n",
        "  ANY_VALUE(putl.workspace_id) AS workspace_id, -- to be used in url in table column start_time\n",
        "  ANY_VALUE(pipeline.pipeline_id) AS pipeline_id, -- to be used in url in table column start_time\n",
        "  putl.update_id, -- to be used in url in table column start_time\n",
        "  -- For runs with trigger_type JOB_TASK and RETRY_ON_FAILURE, retry_count is displayed.\n",
        "  -- Jobs & Pipelines UI doesn't have a column retry_count.\n",
        "  CASE\n",
        "    WHEN ANY_VALUE(putl.trigger_details.job_task.job_id) IS NOT NULL\n",
        "         AND ANY_VALUE(putl.trigger_details.job_task.job_task_run_id) IS NOT NULL THEN\n",
        "      ROW_NUMBER() OVER (\n",
        "        PARTITION BY\n",
        "          ANY_VALUE(putl.trigger_details.job_task.job_id), ANY_VALUE(putl.trigger_details.job_task.job_task_run_id)\n",
        "          ORDER BY MIN(putl.period_start_time)\n",
        "      ) - 1\n",
        "      ELSE 0\n",
        "  END AS retry_count\n",
        "FROM\n",
        "  system.lakeflow.pipeline_update_timeline AS putl\n",
        "LEFT JOIN system.lakeflow.pipelines AS pipeline\n",
        "ON putl.pipeline_id = pipeline.pipeline_id\n",
        "  AND pipeline.delete_time IS NULL\n",
        "LEFT JOIN system.lakeflow.job_task_run_timeline AS jtrtl\n",
        "ON putl.trigger_details.job_task.job_task_run_id = jtrtl.run_id\n",
        "WHERE putl.update_type IN ('REFRESH', 'FULL_REFRESH')\n",
        "  -- Jobs & Pipelines UI > Runs only shows runs from pipelines that have completed at least one successful update.\n",
        "  -- Pipelines that have only ever failed (never had a COMPLETED run) are excluded from the Runs list entirely.\n",
        "  -- Once a pipeline succeeds at least once, all its runs (including earlier failures) become visible retroactively.\n",
        "  AND pipeline.name IN (\n",
        "    -- Name based, as multiple pipelines may have same name but different id's.\n",
        "    -- If only one pipeline with same name ever completed, runs of all pipelines with that name appear in the results.\n",
        "    -- Example: '[pr 3588 mi_devopssvc_kbdpl_dev_weu] pipeline: upk bronze-2-silver (dev)'\n",
        "    SELECT name\n",
        "    FROM pipelines_at_least_one_time_completed\n",
        "\n",
        "    -- SELECT p2.name\n",
        "    -- FROM system.lakeflow.pipeline_update_timeline AS putl_completed_2\n",
        "    -- INNER JOIN system.lakeflow.pipelines AS p2\n",
        "    -- ON putl_completed_2.pipeline_id = p2.pipeline_id\n",
        "    -- WHERE putl_completed_2.result_state = 'COMPLETED'\n",
        "    --   AND putl_completed_2.update_type IN ('REFRESH', 'VALIDATE', 'FULL_REFRESH')\n",
        ")\n",
        "  -- AND (pipeline.settings.development IS NULL OR pipeline.settings.development = false)\n",
        "  -- AND putl.trigger_type <> 'RETRY_ON_FAILURE' -- consider adding this filter\n",
        "GROUP BY\n",
        "  putl.update_id\n",
        "ORDER BY\n",
        "  start_time DESC;\n",
        "\n"
      ]
    }
  ],
